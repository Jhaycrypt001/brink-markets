NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
MARKET_CACHE_TTL_MS=3000
MARKET_CACHE_STALE_MS=30000
MARKET_MAX_RESULTS=100
CORS_ORIGIN=http://localhost:5173

# DreamDEX / Somnia wiring is intentionally added only when the SDK adapter is connected.
# SOMNIA_INDEXER_URL=
# SOMNIA_WS_RPC_URL=
# SOMNIA_CHAIN_ID=50312
# BRINK_TEST_PRIVATE_KEY=0x... # local only; never commit or share
# BRINK_TEST_AMOUNT=1
# BRINK_CONFIRM_TRADE=YES # only set immediately before the approved test order

# Brink AI (server-side LLM). Copy this file to .env and add ONE key.
# Without a key, Brink AI falls back to the offline heuristic — everything else runs fine.
#
# Recommended: Google Gemini — free tier, get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# BRINK_AI_MODEL=gemini-2.0-flash   # optional (default). e.g. gemini-2.5-flash
#
# Alternative: Anthropic Claude (paid). Used only if GEMINI_API_KEY is empty.
# ANTHROPIC_API_KEY=sk-ant-...
# BRINK_AI_MODEL=claude-opus-5
