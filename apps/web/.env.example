# Base URL of the Brink API (Fastify). Defaults to http://127.0.0.1:8787.
VITE_API_BASE_URL=http://127.0.0.1:8787

# thirdweb client id for wallet connect (Somnia Shannon).
# Get one at https://thirdweb.com/dashboard -> Settings -> API Keys -> create a
# Client ID (public). Paste it here; without it the connect button is disabled.
VITE_THIRDWEB_CLIENT_ID=
